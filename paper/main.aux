\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Accuracy comparison across all 9 held-out benchmarks. DeepSafe (blue, solid) consistently achieves top accuracy. Error bars indicate $\pm 1$ standard deviation across 5 random seeds.\relax }}{}{figure.caption.23}\protected@file@percent }
