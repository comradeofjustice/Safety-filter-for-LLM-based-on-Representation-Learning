\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Simple classification baselines (LR, MLP, Euclidean projection head) vs.\ DeepSafe across all 9 held-out benchmarks. All baselines use the same frozen Qwen3-Embedding-8B encoder but without hyperbolic projection or DeepSafe training objectives.\relax }}{}{figure.caption.15}\protected@file@percent }
\newlabel{fig:baselines}{{1}{}{Simple classification baselines (LR, MLP, Euclidean projection head) vs.\ DeepSafe across all 9 held-out benchmarks. All baselines use the same frozen Qwen3-Embedding-8B encoder but without hyperbolic projection or DeepSafe training objectives.\relax }{figure.caption.15}{}}
