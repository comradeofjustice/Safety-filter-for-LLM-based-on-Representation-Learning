\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.4}Ablation: Hyperbolic vs.\ Euclidean}{}{subsubsection.7.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Ablation: Euclidean vs.\ Hyperbolic projection heads at four hidden dimensions (64, 128, 256, 512), trained with BCE loss only (no DeepSafe loss components). Hyperbolic geometry alone provides no consistent advantage over Euclidean projection. The benefit emerges only when combined with the full DeepSafe loss.\relax }}{}{figure.caption.27}\protected@file@percent }
\newlabel{fig:ablation}{{6}{}{Ablation: Euclidean vs.\ Hyperbolic projection heads at four hidden dimensions (64, 128, 256, 512), trained with BCE loss only (no DeepSafe loss components). Hyperbolic geometry alone provides no consistent advantage over Euclidean projection. The benefit emerges only when combined with the full DeepSafe loss.\relax }{figure.caption.27}{}}
\newlabel{fig:ablation@cref}{{[figure][6][]6}{[][16][]}}
\@LN{403}{17}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.5}Representation Space Visualization}{}{subsubsection.7.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces t-SNE visualization of original Qwen3-Embedding-0.6B embeddings (left, 2D silhouette $\approx 0.008$) vs.\ DeepSafe-projected embeddings (right, 2D silhouette $\approx 0.36$). The projection head learns to structurally separate safe from unsafe content; see \S  \ref  {sec:exp} for full 256-dimensional silhouette scores.\relax }}{}{figure.caption.28}\protected@file@percent }
\newlabel{fig:tsne}{{7}{}{t-SNE visualization of original Qwen3-Embedding-0.6B embeddings (left, 2D silhouette $\approx 0.008$) vs.\ DeepSafe-projected embeddings (right, 2D silhouette $\approx 0.36$). The projection head learns to structurally separate safe from unsafe content; see \S \ref {sec:exp} for full 256-dimensional silhouette scores.\relax }{figure.caption.28}{}}
\newlabel{fig:tsne@cref}{{[figure][7][]7}{[][17][]}}
