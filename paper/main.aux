\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Per-Benchmark Accuracy and Model Comparison}{}{subsection.7.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Accuracy comparison across all 9 held-out benchmarks. DeepSafe (blue, solid) consistently achieves top accuracy. Error bars indicate $\pm 1$ standard deviation across 5 random seeds.\relax }}{}{figure.caption.16}\protected@file@percent }
\newlabel{fig:benchmark_accuracy}{{2}{}{Accuracy comparison across all 9 held-out benchmarks. DeepSafe (blue, solid) consistently achieves top accuracy. Error bars indicate $\pm 1$ standard deviation across 5 random seeds.\relax }{figure.caption.16}{}}
\newlabel{fig:benchmark_accuracy@cref}{{[figure][2][]2}{[][9][]}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Performance radar chart: DeepSafe vs.\nobreakspace  {}5 SOTA models across 9 benchmarks. DeepSafe (solid blue line with shaded 95\% confidence interval) demonstrates consistent performance across diverse safety domains.\relax }}{}{figure.caption.17}\protected@file@percent }
\newlabel{fig:radar}{{3}{}{Performance radar chart: DeepSafe vs.~5 SOTA models across 9 benchmarks. DeepSafe (solid blue line with shaded 95\% confidence interval) demonstrates consistent performance across diverse safety domains.\relax }{figure.caption.17}{}}
\newlabel{fig:radar@cref}{{[figure][3][]3}{[][10][]}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Head-to-head comparison across 9 benchmarks $\times $ 9 SOTA models (81 unique pairings). Cell $(i,j)$ shows the fraction of benchmarks where row model $i$ achieves higher accuracy than column model $j$. Red = high win rate, Blue = low. DeepSafe row highlighted with black border.\relax }}{}{figure.caption.18}\protected@file@percent }
\newlabel{fig:head_to_head}{{4}{}{Head-to-head comparison across 9 benchmarks $\times $ 9 SOTA models (81 unique pairings). Cell $(i,j)$ shows the fraction of benchmarks where row model $i$ achieves higher accuracy than column model $j$. Red = high win rate, Blue = low. DeepSafe row highlighted with black border.\relax }{figure.caption.18}{}}
\newlabel{fig:head_to_head@cref}{{[figure][4][]4}{[][11][]}}
\@LN{339}{12}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}Throughput vs.\ Accuracy}{}{subsection.7.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Throughput vs.\ accuracy: DeepSafe achieves strong accuracy with competitive throughput (samples/second), benefiting from batched embedding-based inference. Diamond marker = DeepSafe with $\pm 1\sigma $ error bar.\relax }}{}{figure.caption.19}\protected@file@percent }
\newlabel{fig:speed_vs_accuracy}{{5}{}{Throughput vs.\ accuracy: DeepSafe achieves strong accuracy with competitive throughput (samples/second), benefiting from batched embedding-based inference. Diamond marker = DeepSafe with $\pm 1\sigma $ error bar.\relax }{figure.caption.19}{}}
\newlabel{fig:speed_vs_accuracy@cref}{{[figure][5][]5}{[][12][]}}
\@LN{340}{13}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Ablation: Hyperbolic vs.\ Euclidean}{}{subsection.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Ablation: Euclidean vs.\ Hyperbolic projection heads at four hidden dimensions (64, 128, 256, 512), trained with BCE loss only (no DeepSafe loss components). The difference is within $\pm 0.003$, confirming that hyperbolic geometry alone provides no advantage. The benefit emerges only when combined with the full DeepSafe loss (hierarchical contrastive + OT + prototype + decorrelation + counterfactual).\relax }}{}{figure.caption.20}\protected@file@percent }
\newlabel{fig:ablation}{{6}{}{Ablation: Euclidean vs.\ Hyperbolic projection heads at four hidden dimensions (64, 128, 256, 512), trained with BCE loss only (no DeepSafe loss components). The difference is within $\pm 0.003$, confirming that hyperbolic geometry alone provides no advantage. The benefit emerges only when combined with the full DeepSafe loss (hierarchical contrastive + OT + prototype + decorrelation + counterfactual).\relax }{figure.caption.20}{}}
\newlabel{fig:ablation@cref}{{[figure][6][]6}{[][13][]}}
\@LN{341}{14}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.5}Representation Space Visualization}{}{subsection.7.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces t-SNE visualization of original frozen embeddings (left, silhouette $\approx 0.012$) vs.\ DeepSafe-projected embeddings (right, silhouette $\approx 0.346$). The projection head learns to structurally separate safe from unsafe content in the embedding space.\relax }}{}{figure.caption.21}\protected@file@percent }
\newlabel{fig:tsne}{{7}{}{t-SNE visualization of original frozen embeddings (left, silhouette $\approx 0.012$) vs.\ DeepSafe-projected embeddings (right, silhouette $\approx 0.346$). The projection head learns to structurally separate safe from unsafe content in the embedding space.\relax }{figure.caption.21}{}}
\newlabel{fig:tsne@cref}{{[figure][7][]7}{[][14][]}}
\@LN{342}{14}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.6}Trivial Baseline Sanity Check}{}{subsection.7.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Trivial baselines (predict-all-safe, majority class) vs.\ DeepSafe. On benchmarks with severe class imbalance (e.g., DoNotAnswer, 98.6\% safe), naive strategies achieve high accuracy but zero MCC, highlighting the need for macro-averaged metrics alongside accuracy.\relax }}{}{figure.caption.22}\protected@file@percent }
\newlabel{fig:trivial_baselines}{{8}{}{Trivial baselines (predict-all-safe, majority class) vs.\ DeepSafe. On benchmarks with severe class imbalance (e.g., DoNotAnswer, 98.6\% safe), naive strategies achieve high accuracy but zero MCC, highlighting the need for macro-averaged metrics alongside accuracy.\relax }{figure.caption.22}{}}
\newlabel{fig:trivial_baselines@cref}{{[figure][8][]8}{[][15][]}}
